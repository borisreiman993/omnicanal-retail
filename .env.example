# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# --- General ---
NOMBRE_TIENDA=OmniSport
SLOGAN_TIENDA=compra como quieras, retira donde quieras.
DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos PostgreSQL (local) ---
DB_NAME=omnicanal
DB_USER=postgres
DB_PASSWORD=PON_AQUI_TU_CONTRASENA_DE_POSTGRES
DB_HOST=localhost
DB_PORT=5432

# --- Reglas de negocio (parametros del informe) ---
RESERVA_MINUTOS=15

# --- Correo (RF-12) ---
# Por defecto los correos se muestran en la consola donde corre el servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@retail-omnicanal.local
# Para usar un SMTP real, cambia EMAIL_BACKEND a
# django.core.mail.backends.smtp.EmailBackend y completa:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Pagos (RF-08) ---
# "simulado" = pagina de pago simulada (por defecto).
# "paypal_sandbox" = PayPal Sandbox real (requiere credenciales de developer.paypal.com).
PAGO_PROVEEDOR=simulado
PAGO_MONEDA=CLP
PAGO_CUENTA_RECEPTORA=comercio-sandbox@example.com
# Solo para el modo simulado: que pasa con un pago de resultado incierto
# cuando el proceso programado lo vuelve a consultar: completada | rechazada | incierta
SIMULACION_INCIERTO=completada
# Solo para paypal_sandbox:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MONEDA=USD
PAYPAL_CLP_POR_UNIDAD=950

# --- Respaldos ---
# Carpeta donde esta pg_dump.exe (ajusta la version si instalaste otra)
PG_BIN=C:\Program Files\PostgreSQL\16\bin
